# CSI Passive Sniffer defaults for ESP32-S3-N16R8
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Anchor AP: set to the BSSID of the room AP whose beacons will provide CSI.
# Find it with: iw dev wlan0 scan | grep -A5 "YOUR_SSID" | grep BSS
CONFIG_CSI_ANCHOR_MAC="00:00:00:00:00:00"

# Channel the anchor AP broadcasts on (router admin page or a Wi-Fi scanner)
CONFIG_CSI_CHANNEL=6

# Room Pi address. Phase 2a prints JSON on UART and does not open a UDP socket;
# this Kconfig value is the address to use when UDP streaming is enabled.
# Set it in menuconfig (CSI Passive Configuration → UDP target IP).
CONFIG_CSI_UDP_TARGET_IP="0.0.0.0"
