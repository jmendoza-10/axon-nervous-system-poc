menu "CSI TX Configuration"

    config CSI_TX_SSID
        string "WiFi SSID for CSI AP"
        default "YOUR_SSID"
        help
            SSID of the Wi-Fi network the transmitter joins. Replace YOUR_SSID
            via menuconfig (or scripts/flash_esp32.sh --wifi-ssid) before flashing.

    config CSI_TX_PASSWORD
        string "WiFi Password"
        default "YOUR_PASSWORD"
        help
            Passphrase for that Wi-Fi network. Replace YOUR_PASSWORD via
            menuconfig (or scripts/flash_esp32.sh --wifi-pass) before flashing.
            Leave empty for an open network.


endmenu
