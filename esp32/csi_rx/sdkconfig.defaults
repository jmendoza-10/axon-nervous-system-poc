# CSI RX defaults for ESP32-S3-N16R8
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Home WiFi — must match TX so both are on same network/channel for CSI

# Pi room node IP on home WiFi
CONFIG_CSI_RX_SSID="SETUP-10EC"
CONFIG_CSI_RX_PASSWORD="badge5585detail"
CONFIG_CSI_UDP_TARGET_IP="192.168.0.47"
