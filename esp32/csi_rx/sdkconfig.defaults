# CSI RX defaults for ESP32-S3-N16R8
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Home Wi-Fi — must match the TX board so both sit on the same channel.
# Replace YOUR_SSID / YOUR_PASSWORD before building:
#   idf.py menuconfig  →  CSI RX Configuration
# or pass --wifi-ssid / --wifi-pass to scripts/flash_esp32.sh.
CONFIG_CSI_RX_SSID="YOUR_SSID"
CONFIG_CSI_RX_PASSWORD="YOUR_PASSWORD"

# Room Pi address for the CSI UDP stream. 0.0.0.0 means unset.
# Set it in menuconfig (CSI RX Configuration → UDP target IP)
# or pass --pi-host to scripts/flash_esp32.sh.
CONFIG_CSI_UDP_TARGET_IP="0.0.0.0"
