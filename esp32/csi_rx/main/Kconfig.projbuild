menu "CSI RX Configuration"

    config CSI_RX_SSID
        string "CSI TX AP SSID to connect to"
        default "YOUR_SSID"
        help
            SSID of the Wi-Fi network the receiver joins. Replace YOUR_SSID
            via menuconfig (or scripts/flash_esp32.sh --wifi-ssid) before flashing.

    config CSI_RX_PASSWORD
        string "CSI TX AP Password"
        default "YOUR_PASSWORD"
        help
            Passphrase for that Wi-Fi network. Replace YOUR_PASSWORD via
            menuconfig (or scripts/flash_esp32.sh --wifi-pass) before flashing.

    config CSI_UDP_TARGET_IP
        string "UDP target IP (Raspberry Pi)"
        default "0.0.0.0"
        help
            IP address of the Raspberry Pi room node that receives CSI JSON.
            0.0.0.0 means unset. Set the Pi's address in menuconfig, or pass
            --pi-host to scripts/flash_esp32.sh.

    config CSI_UDP_TARGET_PORT
        int "UDP target port"
        default 5500
        range 1024 65535
        help
            UDP port on the Raspberry Pi listening for CSI JSON data.

endmenu
